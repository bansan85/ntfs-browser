{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
                "CMAKE_VS_GLOBALS": "UseMultiToolTask=true;EnforceProcessCountAcrossBuilds=true"
            }
        },
        {
            "name": "shared",
            "displayName": "Shared",
            "inherits": "base",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON"
            }
        },
        {
            "name": "static",
            "displayName": "Static",
            "inherits": "base",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "vcpkg-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets"
            }
        },
        {
            "name": "shared-vcpkg",
            "displayName": "Shared (vcpkg, x64-windows)",
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_HOST_TRIPLET": "x64-windows"
            }
        },
        {
            "name": "static-vcpkg",
            "displayName": "Static /MD (vcpkg, x64-windows-static-md)",
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
                "VCPKG_HOST_TRIPLET": "x64-windows-static-md"
            }
        },
        {
            "name": "no-decompression",
            "displayName": "Static, LZNT1 decompression disabled",
            "inherits": "static",
            "cacheVariables": {
                "NTFS_BROWSER_ENABLE_DECOMPRESSION": "OFF"
            }
        },
        {
            "name": "efs-cryptopp-only",
            "displayName": "Static, EFS decryption via Crypto++ only",
            "inherits": "static",
            "cacheVariables": {
                "NTFS_BROWSER_ENABLE_EFS_BCRYPT": "OFF"
            }
        },
        {
            "name": "efs-bcrypt-only",
            "displayName": "Static, EFS decryption via BCrypt only",
            "inherits": "static",
            "cacheVariables": {
                "NTFS_BROWSER_ENABLE_EFS_CRYPTOPP": "OFF"
            }
        },
        {
            "name": "no-efs",
            "displayName": "Static, EFS decryption disabled (both backends off)",
            "inherits": "static",
            "cacheVariables": {
                "NTFS_BROWSER_ENABLE_EFS_CRYPTOPP": "OFF",
                "NTFS_BROWSER_ENABLE_EFS_BCRYPT": "OFF"
            }
        },
        {
            "name": "vs2022-amd64",
            "displayName": "Visual Studio Community 2022 Release - amd64",
            "generator": "Visual Studio 17 2022",
            "toolset": "host=x64",
            "architecture": "x64",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "vs2026-x86",
            "displayName": "Visual Studio Community 2026 Release - x86",
            "generator": "Visual Studio 18 2026",
            "toolset": "host=x64",
            "architecture": "Win32",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "shared-relwithdebinfo",
            "displayName": "Shared RelWithDebInfo",
            "inherits": "shared",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "static-relwithdebinfo",
            "displayName": "Static RelWithDebInfo",
            "inherits": "static",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "shared-vcpkg-relwithdebinfo",
            "displayName": "Shared (vcpkg, x64-windows) RelWithDebInfo",
            "inherits": "shared-vcpkg",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "static-vcpkg-relwithdebinfo",
            "displayName": "Static /MD (vcpkg, x64-windows-static-md) RelWithDebInfo",
            "inherits": "static-vcpkg",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "no-decompression-relwithdebinfo",
            "displayName": "Static, LZNT1 decompression disabled RelWithDebInfo",
            "inherits": "no-decompression",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "efs-cryptopp-only-relwithdebinfo",
            "displayName": "Static, EFS decryption via Crypto++ only RelWithDebInfo",
            "inherits": "efs-cryptopp-only",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "efs-bcrypt-only-relwithdebinfo",
            "displayName": "Static, EFS decryption via BCrypt only RelWithDebInfo",
            "inherits": "efs-bcrypt-only",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "no-efs-relwithdebinfo",
            "displayName": "Static, EFS decryption disabled (both backends off) RelWithDebInfo",
            "inherits": "no-efs",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "vs2022-amd64-relwithdebinfo",
            "displayName": "Visual Studio Community 2022 RelWithDebInfo - amd64",
            "inherits": "vs2022-amd64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "vs2026-x86-relwithdebinfo",
            "displayName": "Visual Studio Community 2026 RelWithDebInfo - x86",
            "inherits": "vs2026-x86",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
