---
Checks:          '*,-llvmlibc-restrict-system-libc-headers,-llvmlibc-implementation-in-namespace,-llvm-prefer-static-over-anonymous-namespace,-modernize-use-trailing-return-type,-llvmlibc-callee-namespace,-portability-avoid-pragma-once,-llvm-header-guard,-altera-struct-pack-align,-llvmlibc-inline-function-decl,-boost-use-ranges,-misc-include-cleaner,-altera-unroll-loops,-fuchsia-default-arguments-calls,-bugprone-macro-parentheses,-readability-avoid-unconditional-preprocessor-if,-readability-trailing-comma,-modernize-use-designated-initializers,-cppcoreguidelines-pro-type-reinterpret-cast,-readability-math-missing-parentheses,-bugprone-easily-swappable-parameters,-misc-non-private-member-variables-in-classes,-fuchsia-default-arguments-declarations,-clang-analyzer-optin.core.EnumCastOutOfRange,-google-default-arguments,-fuchsia-multiple-inheritance,-misc-multiple-inheritance,-portability-template-virtual-member-function,-cppcoreguidelines-pro-type-union-access,-cppcoreguidelines-pro-bounds-constant-array-index,-google-runtime-int,-llvm-use-ranges,-android-cloexec-*,-concurrency-mt-unsafe'
WarningsAsErrors: '*'
HeaderFileExtensions:
  - ''
  - h
  - hh
  - hpp
  - hxx
ImplementationFileExtensions:
  - c
  - cc
  - cpp
  - cxx
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '.*[/\\](3rdparty|win-types\.h)([/\\].*)?$'
FormatStyle:     none
CheckOptions:
  # Use typedef for Windows type
  - key: readability-identifier-naming.TypedefCase
    value: 'UPPER_CASE'
  # Use using for library type
  - key: readability-identifier-naming.TypeAliasCase
    value: 'CamelCase'
  - key: readability-identifier-naming.NamespaceCase
    value: 'CamelCase'
  - key: readability-identifier-naming.EnumCase
    value: 'CamelCase'
  - key: readability-identifier-naming.EnumConstantCase
    value: 'CamelCase'
  - key: readability-identifier-naming.ClassCase
    value: 'CamelCase'
  - key: readability-identifier-naming.StructCase
    value: 'CamelCase'
  - key: readability-identifier-naming.UnionCase
    value: 'CamelCase'
  - key: readability-identifier-naming.MemberCase
    value: 'lower_case'
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: '_'
  - key: readability-identifier-naming.ParameterCase
    value: 'lower_case'
  - key: readability-identifier-naming.LocalVariableCase
    value: 'lower_case'
  - key: readability-identifier-naming.StaticVariableCase
    value: 'lower_case'
  - key: readability-identifier-naming.GlobalVariableCase
    value: 'lower_case'
  - key: readability-identifier-naming.ClassMemberCase
    value: 'lower_case'
  - key: readability-identifier-naming.ConstexprVariableCase
    value: 'lower_case'
  - key: readability-identifier-naming.FunctionCase
    value: 'CamelCase'
  - key: readability-identifier-naming.TemplateParameterCase
    value: 'CamelCase'
  - key: readability-identifier-naming.ConceptCase
    value: 'CamelCase'
  - key: readability-identifier-naming.MacroDefinitionCase
    value: 'UPPER_CASE'
SystemHeaders:   false
...
