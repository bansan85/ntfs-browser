---
Checks:          '*,-llvmlibc-restrict-system-libc-headers,-llvmlibc-implementation-in-namespace,-llvm-prefer-static-over-anonymous-namespace,-modernize-use-trailing-return-type,-llvmlibc-callee-namespace,-portability-avoid-pragma-once,-llvm-header-guard,-altera-struct-pack-align,-llvmlibc-inline-function-decl,-boost-use-ranges,-misc-include-cleaner,-altera-unroll-loops,-fuchsia-default-arguments-calls,-bugprone-macro-parentheses,-readability-avoid-unconditional-preprocessor-if,-readability-trailing-comma,-modernize-use-designated-initializers,-cppcoreguidelines-pro-type-reinterpret-cast,-readability-math-missing-parentheses,-bugprone-easily-swappable-parameters,-misc-non-private-member-variables-in-classes,-fuchsia-default-arguments-declarations,-clang-analyzer-optin.core.EnumCastOutOfRange,-google-default-arguments,-fuchsia-multiple-inheritance,-misc-multiple-inheritance,-portability-template-virtual-member-function,-cppcoreguidelines-pro-type-union-access,-cppcoreguidelines-pro-bounds-constant-array-index,-google-runtime-int,-llvm-use-ranges,-android-cloexec-*'
WarningsAsErrors: '*'
HeaderFileExtensions:
  - ''
  - h
  - hh
  - hpp
  - hxx
ImplementationFileExtensions:
  - c
  - cc
  - cpp
  - cxx
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '.*[/\\]3rdparty[/\\].*'
FormatStyle:     none
CheckOptions:    {}
SystemHeaders:   false
...
